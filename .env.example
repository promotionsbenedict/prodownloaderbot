# Copy to .env on the VPS only and chmod 600.
BOT_TOKEN=
# Generate a URL-safe value with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Comma-separated Telegram numeric IDs
ADMIN_IDS=
SUPPORT_CONTACT=
# Required. Comma-separated IP addresses or CIDRs, including every public
# address on the VPS (IPv4 and IPv6), and any public management addresses.
DENY_NETWORKS=
WORKER_SLOTS=2
MAX_MEDIA_MIB=200
CACHE_CAP_MIB=2048
ENABLE_BROWSER=1
# Optional. Use a dedicated HTTPS origin with compose.links.yaml.
PUBLIC_BASE_URL=
FILE_SIGNING_KEY=
LINK_PORT=18762
